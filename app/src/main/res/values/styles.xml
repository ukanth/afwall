<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="Theme.Transparent" parent="android:Theme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="TextLarge" parent="@android:style/TextAppearance.DeviceDefault.Large" />

    <style name="TextMedium" parent="@android:style/TextAppearance.DeviceDefault.Medium" />


    <style name="AppLightTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:textColor">@color/black</item>


        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/black</item>

        <item name="itemBackground">@color/white</item>

        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/black</item>

        <item name="colorControlNormal">@color/black</item>
        <item name="tint">@color/black</item>
    </style>

    <!-- High-contrast light theme for E-paper displays (Issue #1308) -->
    <style name="AppLightHighContrastTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:textColor">@color/black</item>

        <!-- White toolbar for maximum contrast with black text -->
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryDark">@color/white</item>
        <item name="colorAccent">@color/black</item>

        <item name="itemBackground">@color/white</item>

        <!-- Ensure all text is pure black -->
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/black</item>

        <!-- Checkbox colors - pure black for maximum contrast -->
        <item name="colorControlNormal">@color/black</item>
        <item name="colorControlActivated">@color/black</item>
        <item name="colorControlHighlight">@color/black</item>
        <item name="android:colorControlNormal">@color/black</item>
        <item name="android:colorControlActivated">@color/black</item>
        <item name="tint">@color/black</item>

        <!-- Explicit checkbox style -->
        <item name="checkboxStyle">@style/HighContrastCheckBox</item>
    </style>

    <!-- High contrast checkbox style for e-paper displays -->
    <style name="HighContrastCheckBox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:buttonTint">@color/black</item>
        <item name="buttonTint">@color/black</item>
    </style>

    <!-- Dark style for all standard Locale and Locale plug-in Activity instances -->
    <style name="Theme.Locale.Dark" parent="android:Theme" />

